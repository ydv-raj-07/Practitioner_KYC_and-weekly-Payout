{
  "name": "practitioner_kyc",
  "version": "1.0.0",
  "description": "Node.js application handling automated KYC verification and weekly payment processing, featuring an admin dashboard to review, accept, or reject user applications.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ydv-raj-07/Practitioner_KYC_and-weekly-Payout.git"
  },
  "author": "Raj Ranjan",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ydv-raj-07/Practitioner_KYC_and-weekly-Payout/issues"
  },
  "homepage": "https://github.com/ydv-raj-07/Practitioner_KYC_and-weekly-Payout#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "crypto": "^1.0.1",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
